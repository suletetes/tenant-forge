# --- Server ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database ---
# App role: NOSUPERUSER, NOBYPASSRLS — used for all runtime traffic (R6.3)
DATABASE_URL=postgresql://tenantforge_app:app_pw@localhost:5432/tenantforge
# Migrator role: owns tables / bypasses RLS — used ONLY by migrations (R18.2)
MIGRATION_DATABASE_URL=postgresql://tenantforge_migrator:migrator_pw@localhost:5432/tenantforge

# --- Auth (R3) ---
# In AWS these come from Secrets Manager; locally use env. NEVER commit real values.
JWT_SIGNING_SECRET=dev-only-change-me-min-32-bytes-long-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# --- Stripe (V2, test mode only) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Redis (V2) ---
REDIS_URL=redis://localhost:6379
